if ! (return 0 &>/dev/null); then
  echo "source $0, do not execute it.";
  exit 1;
fi

if [ -n "$BASH_SOURCE" ]; then
	SCRIPT_PATH="${BASH_SOURCE[0]}"
elif [ -n "$ZSH_VERSION" ]; then
	SCRIPT_PATH="${(%):-%x}"
else
	SCRIPT_PATH="$0"
fi

SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
export PIN_ROOT="${SCRIPT_DIR}/contrib/pin-external-4.2-99776-g21d818fa2-gcc-linux"
export PATH="${SCRIPT_DIR}/contrib/e9patch:${SCRIPT_DIR}/contrib/ghidra_11.0.3_PUBLIC/support:${PIN_ROOT}:${PATH}"
source "${SCRIPT_DIR}/contrib/bin2cet/bin/activate"
